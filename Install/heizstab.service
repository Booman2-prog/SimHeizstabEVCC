[Unit]
Description=Heizstab-Steuerung fuer evcc
# erst starten, wenn das Netzwerk steht (ESP, NAS, Home Assistant)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homeserver
# Laeuft direkt aus dem geklonten Repository - Update per "git pull".
# config.json und evcc_state.json liegen im selben Ordner, sind aber nicht
# im Repository und werden von "git pull" daher nie ueberschrieben.
WorkingDirectory=/home/homeserver/SimHeizstabEVCC/Install
ExecStart=/usr/bin/python3 /home/homeserver/SimHeizstabEVCC/Install/control.py
# bei Absturz oder Fehler nach 5 s automatisch neu starten
Restart=always
RestartSec=5
# Ausgaben sofort ins Systemprotokoll (journalctl), nicht gepuffert
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
