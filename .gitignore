# Nur das eigentliche Projekt versionieren (Whitelist).
# Alles andere - insbesondere Dateien mit Passwoertern/Tokens - bleibt lokal.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/evcc.example.yaml
!/tests/
!/Install/

# Install/ enthaelt nur, was fuer die Installation noetig ist
/Install/*
!/Install/control.py
!/Install/webui.py
!/Install/heizstab.service
!/Install/config.example.json

# echte Konfiguration und Laufzeitdaten NIE einchecken
config.json
config.json.bak
config.json.tmp
evcc_state.json
*.log
__pycache__/
.pytest_cache/
!/.gitattributes
